{
  "argumentDefaults": {
    "runtimeArgumentStartIndex": 2,
    "helpFlag": "--help",
    "defaultOutputFormat": "text",
    "defaultMode": "live"
  },
  "probabilityThresholds": {
    "defaultViolationProbabilityThreshold": 0.7,
    "maximumPassProbability": 0.4,
    "minimumViolationProbabilityExclusive": 0.5,
    "maximumViolationProbability": 1
  },
  "ruleFiles": {
    "ruleFilePattern": "rules/**/*.md",
    "firstRuleOrdinal": 1,
    "ruleIdPrefix": "rule_"
  },
  "evidence": {
    "sourceFileExtensions": [".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"],
    "repositoryFileExtensions": [
      ".ts",
      ".tsx",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".json",
      ".toml",
      ".yaml",
      ".yml",
      ".md"
    ],
    "sourceChunkLineCount": 80,
    "sourceChunkOverlapLineCount": 20,
    "maximumEvaluationRequestBytes": 32000
  },
  "routing": {
    "maximumChoiceOptions": 16,
    "beamWidth": 3,
    "maximumConcurrentRequests": 800,
    "maximumExpandedCandidates": 12,
    "maximumSelectedEvidence": 6,
    "minimumRelevanceProbability": 0.45,
    "maximumEvidenceSnippetBytes": 6000
  },
  "outputFormat": {
    "jsonIndentSpaces": 2,
    "unknownLanguageName": "unknown",
    "sourceFileLabel": "Source file",
    "noChangedFiles": "No changed files to lint."
  },
  "questionPrompt": {
    "evaluationTask": "Does the identified candidate violate the supplied semantic lint rule?",
    "evaluationGuidance": "Judge only the identified candidate. Use the supplied repository and change evidence when the rule requires comparison. The caller handles applicability and evidence sufficiency before asking this question.",
    "violationCriterion": "The candidate contains a concrete violation supported by the supplied evidence.",
    "complianceCriterion": "The supplied evidence shows no concrete violation in the candidate."
  },
  "processExitCodes": {
    "success": 0,
    "findingsFound": 1,
    "runtimeError": 2
  }
}
